# Copia este archivo como .streamlit/secrets.toml (ese sí NO se sube a git,
# ya está en .gitignore) y llena tus credenciales reales de Odoo cuando
# actives la conexión en odoo_connector.py.
#
# En Streamlit Community Cloud: Settings > Secrets, pegas lo mismo ahí
# (no subas nunca el archivo real al repo).

[odoo]
url = "https://tu-instancia.odoo.com"
db = "nombre_de_tu_base"
user = "tu_usuario"
password = "tu_password_o_api_key"
